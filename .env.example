# .env is written by `python scripts/environment.py staging|production`, from a profile kept
# outside the repository (~/.config/thecornerfc/<name>.env), and replaced whole on every switch:
# don't edit it by hand (guide/environments.md). This file shows what it holds.
#
# With no THECORNERFC_ENV nothing can write. `staging` may write to the staging database, once
# the address and the database both say staging. `production` is read-only: its profile holds a
# role that can only read, and the switch asks the database to confirm that first.
THECORNERFC_ENV=staging
THECORNERFC_MODE=local
THECORNERFC_READ_ONLY=false
THECORNERFC_NO_API=true

# Staging: the staging project's address in both. Production: the read-only role's address in
# both (the scripts in experiments/ read DATABASE_URL). Production's write address and the
# API-Football key are never on this machine: they live in GitHub, where the jobs run.
DATABASE_URL=postgresql://postgres.stagingproject:password@aws-0-region.pooler.supabase.com:5432/postgres
READ_ONLY_DATABASE_URL=postgresql://postgres.stagingproject:password@aws-0-region.pooler.supabase.com:5432/postgres
API_FOOTBALL_KEY=
API_DAILY_RESERVE=200

# Leave unset. It lifts the API block for a local staging run only; it does nothing for production.
THECORNERFC_LOCAL_OVERRIDE=

# Persistent request metadata only; usage reporting works in NO_API mode.
API_LEDGER_PATH=.api-usage/ledger.sqlite3
API_QUOTA_WARN_THRESHOLDS=2000,1000,500
# Optional cap across processes sharing API_RUN_ID (Actions uses run ID/attempt).
API_RUN_BUDGET=0
# API_RUN_ID=manual-backfill-unique-id
# Subscription allowance period is unconfirmed. No monthly allowance is assumed.

# Pipeline/dataset health shares API_LEDGER_PATH and its Actions cache/artifact.
# Population below 20% of a successful baseline of >=100 rows fails sanity checks.
HEALTH_COLLAPSE_RATIO=0.2
HEALTH_MIN_BASELINE=100
# Time since last successful monitored stage; stale is a warning, not a fatal failure.
HEALTH_STALE_HOURS=72
