.env
__pycache__/
*.pyc
.venv/
venv/
*.log
logs/
.cache/
.api-usage/
.DS_Store

# The site's data: written here by the export and sent to the database (site.docs, site.matches,
# site.players), which is what the site reads. Not kept in the repository since 2026-10-05.
.export/

# Security audit findings — never commit (public repo)
audit/

# the experiment's output on the agreed settings (16 MB); verify.py reads it when present
experiments/player_no_rating/reference.pickle
experiments/player_no_rating/replay.json
# a saved copy of the database rows an experiment read (run.py --refresh rebuilds it): feed data, never committed
experiments/*/inputs.json.gz

# Claude Code worktrees: local working copies, never part of the site
.claude/worktrees/
