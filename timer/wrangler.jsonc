// The timer (src/index.js): starts the nightly, match-day and FPL jobs on the minute. Built and
// deployed by Cloudflare from this folder on main. It has no address: workers_dev and
// preview_urls are off, and nothing routes to it.
{
	"name": "thecornerfc-timer",
	"main": "src/index.js",
	"compatibility_date": "2026-10-01",
	"workers_dev": false,
	"preview_urls": false,
	// keep its log (Observability tab): each tick writes one line, about 50 a day, well inside the
	// free plan's 200,000
	"observability": { "enabled": true },
	"triggers": {
		"crons": ["17 1 * * *", "*/30 * * * *", "0 7,13,19 * * *"]
	}
}
