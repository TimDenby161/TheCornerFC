// How Cloudflare runs this app: as a Worker named thecornerfc, serving the built files and the
// server code that `npm run build` writes to .svelte-kit/cloudflare.
{
	"name": "thecornerfc",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_als"],
	"assets": { "binding": "ASSETS", "directory": ".svelte-kit/cloudflare" },
	// Which environment this Worker is set up as. The code is built for one too (VITE_SITE_ENV),
	// and refuses to serve if the two differ (src/hooks.server.ts).
	"vars": { "SITE_ENV": "production" },
	// thecornerfc.com only: no workers.dev address and no preview addresses, which would serve the
	// site outside the domain's Cloudflare settings (audit finding S20, 2026-10-16)
	"workers_dev": false,
	"preview_urls": false,
	// keep a log line per request (Observability tab): its CPU time and whether it was cut off,
	// to find what makes pages answer 503 (task T-039). About 23,000 lines a day, inside the free
	// plan's 200,000
	"observability": { "enabled": true },
	// Staging: a second Worker with its own settings and secrets, deployed with
	// `wrangler deploy --env staging` from the staging branch. It has no address of its own:
	// staging.thecornerfc.com is the C# site's staging app (site/) since the switch-over, and
	// there is no workers.dev address and no preview addresses.
	"env": {
		"staging": {
			"name": "thecornerfc-staging",
			"vars": { "SITE_ENV": "staging" },
			"workers_dev": false,
			"preview_urls": false
		}
	}
}
