// How Cloudflare runs this app: as a Worker named thecornerfc, serving the built files and the
// server code that `npm run build` writes to .svelte-kit/cloudflare.
{
	"name": "thecornerfc",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_als"],
	"assets": { "binding": "ASSETS", "directory": ".svelte-kit/cloudflare" },
	// Which environment this Worker is set up as. The code is built for one too (VITE_SITE_ENV),
	// and refuses to serve if the two differ (src/hooks.server.ts).
	"vars": { "SITE_ENV": "production" },
	// thecornerfc.com only: no workers.dev address and no preview addresses, which would serve the
	// site outside the domain's Cloudflare settings (audit finding S20, 2026-10-16)
	"workers_dev": false,
	"preview_urls": false,
	// Staging: a second Worker with its own address, settings and secrets, deployed with
	// `wrangler deploy --env staging` from the staging branch. It answers only at its own domain
	// (behind Cloudflare Access): no workers.dev address and no preview addresses.
	"env": {
		"staging": {
			"name": "thecornerfc-staging",
			"vars": { "SITE_ENV": "staging" },
			"routes": [{ "pattern": "staging.thecornerfc.com", "custom_domain": true }],
			"workers_dev": false,
			"preview_urls": false
		}
	}
}
