// How Cloudflare runs this app: as a Worker named thecornerfc, serving the built files and the
// server code that `npm run build` writes to .svelte-kit/cloudflare.
{
	"name": "thecornerfc",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_als"],
	"assets": { "binding": "ASSETS", "directory": ".svelte-kit/cloudflare" }
}
