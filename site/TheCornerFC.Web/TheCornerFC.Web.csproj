<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <!-- Until the switch-over (audit plan step 9) the current site in web/ keeps the one copy of the
       stylesheets, fonts, icons, each page's intro and the text pages' words: each build copies or
       builds them in, so a fix there reaches both sites. wwwroot/ is made by the build and is not
       in git. -->
  <PropertyGroup>
    <WebSource>$(MSBuildProjectDirectory)/../../web</WebSource>
  </PropertyGroup>
  <ItemGroup>
    <WebStatic Include="$(WebSource)/static/**/*" />
    <WebStyles Include="$(WebSource)/src/styles/**/*" />
    <WebStyles Include="$(WebSource)/src/app.css;$(WebSource)/src/lib/crest-hues.css;$(WebSource)/src/lib/placed.css" />
    <OwnAssets Include="Assets/**/*" />
    <EmbeddedResource Include="$(WebSource)/src/lib/tabInfo.json" LogicalName="tabInfo.json" />
    <EmbeddedResource Include="$(WebSource)/src/text/*.html" LogicalName="text/%(Filename).html" />
    <EmbeddedResource Include="$(WebSource)/src/lib/names.json" LogicalName="names.json" />
  </ItemGroup>
  <!-- The React parts (../client): built into wwwroot/client when their sources change. Needs Node
       on the path (on this Mac it is Homebrew's). -->
  <PropertyGroup>
    <ClientSource>$(MSBuildProjectDirectory)/../client</ClientSource>
  </PropertyGroup>
  <ItemGroup>
    <ClientInputs Include="$(ClientSource)/src/**/*;$(ClientSource)/package.json;$(ClientSource)/vite.config.ts;$(WebSource)/src/lib/**/*.ts;$(WebSource)/src/lib/*.json" Exclude="$(WebSource)/src/lib/**/*.test.ts" />
  </ItemGroup>
  <Target Name="BuildClient" BeforeTargets="CopyWebAssets" Inputs="@(ClientInputs)" Outputs="wwwroot/client/islands.js">
    <Exec Command="npm ci --no-audit --no-fund" WorkingDirectory="$(ClientSource)" Condition="!Exists('$(ClientSource)/node_modules')" EnvironmentVariables="PATH=$(PATH):/opt/homebrew/bin:/usr/local/bin" />
    <Exec Command="npm run build" WorkingDirectory="$(ClientSource)" EnvironmentVariables="PATH=$(PATH):/opt/homebrew/bin:/usr/local/bin" />
  </Target>

  <Target Name="CopyWebAssets" BeforeTargets="BeforeBuild;ResolveStaticWebAssetsInputs">
    <Copy SourceFiles="@(WebStatic)" DestinationFiles="@(WebStatic->'wwwroot/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(WebStyles)" DestinationFiles="@(WebStyles->'wwwroot/styles/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(OwnAssets)" DestinationFiles="@(OwnAssets->'wwwroot/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <ItemGroup>
      <Content Include="wwwroot/**/*" Exclude="@(Content)" />
    </ItemGroup>
  </Target>

</Project>
