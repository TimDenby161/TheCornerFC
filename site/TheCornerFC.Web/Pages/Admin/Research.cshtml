@page "/admin/research"
@model ResearchModel
@removeTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Research · The Corner FC";
    ViewData["NoIndex"] = true;
}
<section class="panel mc" data-tab="research" data-active="true">
    @await Html.PartialAsync("_Accuracy", (Model.Accuracy, "/admin/research", ""))

    <h2 class="mc-h2">Every challenger's running score</h2>
    @if (Model.Challengers.Count == 0)
    {
        <div class="empty-state">The live record has not been stored yet: it is written by the Live tracking job, on Mondays and Thursdays.</div>
    }
    else
    {
        @await Html.PartialAsync("_Challengers", (Model.Challengers, Model.LiveNote, true))
    }
</section>
