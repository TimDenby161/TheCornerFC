@page "/my-fpl-team"
@{
    // The site owner's, and its data is never written here: the owner's browser asks for it
    // (/fantasy/data), and the database answers nobody else
    ViewData["Title"] = "My FPL team · The Corner FC";
    ViewData["NoIndex"] = true;
    ViewData["TabHead"] = TabHead.For("My FPL team", "myteam");
}
<section class="panel" data-tab="myteam" data-active="true">
    @await Html.PartialAsync("_OwnerIsland", new OwnerIslandModel("myteam", "myteam-body", "My FPL team", new { email = Visitor.Of(HttpContext).Email }))
</section>
