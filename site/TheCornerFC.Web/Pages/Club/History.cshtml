@page "/club/{id}/history"
@model TheCornerFC.Web.Pages.ClubTabs.HistoryModel
@{
    ViewData["Title"] = $"{Model.C.Name} history · The Corner FC";
    ViewData["Description"] = $"{Model.C.Name} season by season since 2020: league, record, goals and strength rating at the end of each season.";
    string Move(double v) => $"{(v > 0 ? "+" : "")}{Js.ToFixed(v, 1)}";
}
@if (Model.Seasons.Count == 0)
{
    <div class="empty-state">No match history for this club yet.</div>
}
else
{
    <div class="chart-card"><div class="chart-head"><span class="chart-title">Elo at the end of each season</span></div>
        <div class="season-bars">
            @foreach (var r in Enumerable.Reverse(Model.Seasons))
            {
                <div class="season-bar" title="@r.S.Label: @Js.ToFixed(r.S.End, 1)"><span class="sb-val">@Js.RoundInt(r.S.End)</span>
                    <div class="sb-fill sh-@ClubPage.Pct(r.Bar)"></div><span class="sb-label">@r.S.Label</span></div>
            }
        </div></div>
    <div class="club-section"><div class="modal-section">Season by season</div>
        <table class="season-table"><thead><tr><th>Season</th><th>League · record · goals</th><th class="num">Elo</th><th class="num">Change</th></tr></thead>
            <tbody>
                @for (var i = 0; i < Model.Seasons.Count; i++)
                {
                    var r = Model.Seasons[i];
                    var s = r.S;
                    <tr>
                        <td class="num u-left">@s.Label@if (i == 0){<div class="dim">so far</div>}</td>
                        <td>@if (r.LeagueName is not null){@r.LeagueName}else{<span class="dim">Cups only</span>}
                            <div class="dim">@s.Played played · @(s.W)W @(s.D)D @(s.L)L · @s.Gf–@s.Ga</div></td>
                        <td class="num">@Js.RoundInt(s.End)<div class="dim">high @Js.RoundInt(s.Peak)</div></td>
                        <td class="num">@if (s.Start is { } st){var v = s.End - st;<span class="@(v > 0 ? "form-up" : v < 0 ? "form-down" : "")">@Move(v)</span>}</td>
                    </tr>
                }
            </tbody></table>
        <div class="page-note">Elo: the club's Elo rating after its last match of the season; change: over the season. All competitions.</div></div>
}
