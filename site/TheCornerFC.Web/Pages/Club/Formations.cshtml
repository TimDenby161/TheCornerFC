@page "/club/{id}/formations"
@model TheCornerFC.Web.Pages.ClubTabs.FormationsModel
@{
    ViewData["Title"] = $"{Model.C.Name} formations · The Corner FC";
    ViewData["Description"] = $"The formations {Model.C.Name} have used this season and under their manager, with the record in each.";
}
@if (!Model.Any)
{
    <div class="empty-state">No line-ups for this club (formations come from the leagues with match-by-match player data).</div>
}
else
{
    @if (Model.Boss is { } boss)
    {
        <div class="next-card coach-card">
            @Markup.PersonChip(boss.Name, "coach-photo")
            <div><div class="next-label">Manager</div><div class="coach-name">@boss.Name</div>
                <div class="next-meta">@if (boss.Since is not null){<span>Since @boss.Since</span>}@if (boss.Matches > 0){<span>@boss.Matches matches · @boss.Record</span>}</div></div>
        </div>
    }
    foreach (var s in Model.Sections)
    {
        <div class="club-section"><div class="modal-section">@s.Title</div>
            @if (s.Used.Count > 0)
            {
                <div class="fm-grid">
                    @for (var i = 0; i < s.Used.Count; i++)
                    {
                        var f = s.Used[i];
                        var dots = ClubPage.FormationDots(f.Formation);
                        <div class="fm-card@(i == 0 ? " top" : "")">
                            <svg class="fm-pitch" viewBox="0 0 60 80" aria-hidden="true">
                                <rect x="1" y="1" width="58" height="78" rx="3" class="fm-bg" />
                                <g class="fm-lines"><line x1="1" y1="40" x2="59" y2="40" /><circle cx="30" cy="40" r="6" /><rect x="16" y="1" width="28" height="10" /><rect x="16" y="69" width="28" height="10" /></g>
                                @for (var k = 0; k < dots.Count; k++){<circle cx="@Js.ToFixed(dots[k].X, 1)" cy="@Js.ToFixed(dots[k].Y, 1)" r="3.2" class="@(k > 0 ? "fm-dot" : "fm-gk")" />}
                            </svg>
                            <div class="fm-main"><div class="fm-name">@f.Formation</div>
                                <div class="fm-count">@f.Matches match@(f.Matches == 1 ? "" : "es") · @(f.Share < 1 ? "<1" : Js.RoundInt(f.Share).ToString())%</div>
                                <div class="fm-bar"><span class="sw-@ClubPage.Pct(f.Share)"></span></div>
                                <div class="fm-sub">@f.Record · @f.Gf–@f.Ga</div>
                                <div class="fm-sub">last @(f.Last[..4] == Model.ThisYear ? ClubPage.ShortDate(f.Last) : ClubPage.LongDate(f.Last))</div></div>
                        </div>
                    }
                </div>
                @if (s.Missing > 0){<div class="page-note">@s.Missing match@(s.Missing == 1 ? "" : "es") with no known line-up not counted.</div>}
            }
            else
            {
                <div class="page-note">No line-ups yet.</div>
            }
        </div>
    }
}
