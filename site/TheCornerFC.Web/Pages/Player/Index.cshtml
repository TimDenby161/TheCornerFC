@page "/player/{id}"
@model TheCornerFC.Web.Pages.PlayerTabs.IndexModel
@{
    ViewData["Title"] = $"{Model.P.Name} · The Corner FC";
    ViewData["Description"] = $"{Model.P.Name}{(Model.Team is { } t ? $" ({t.Name})" : "")}: Ability rank, this season's minutes, goals and assists, recent appearances and positions.";
    var now = Model.Now;
}
@if (Model.Next is not null){@await Html.PartialAsync("_NextMatchCard", Model.Next with { Status = Model.Status })}

@if (Model.Chips.Count > 0)
{
    <div class="club-section pos-section">
        <div class="pos-row">
            @foreach (var c in Model.Chips)
            {
                <div class="pos-chip rel-@ClubPage.RankTier(c.Rank)@(c.Main ? " main" : "")" title="@c.Name: rank @Js.ToFixed(c.Rank, 1) · @(c.Pct > 0 ? $"{c.Pct}% of his starting minutes" : "no starts here")">
                    <span class="pos-chip-pos">@c.Group</span><span class="pos-chip-rank">@Js.RoundInt(c.Rank)</span>
                    <span class="pos-chip-pct">@(c.Pct > 0 ? $"{c.Pct}%" : "–")</span></div>
            }
        </div>
    </div>
}

<div class="club-section pl-block">
    <div class="modal-section">Current Season · @Model.SeasonName</div>
    @if (now?.Minutes is > 0)
    {
        <div class="team-stats compact">
            <div class="team-stat"><div class="team-stat-label">Minutes</div><div class="team-stat-value">@Js.Num(now.Minutes.Value)</div>@if (now.Apps is { } ap){<div class="team-stat-sub">@ap apps@(now.Starts is { } st ? $" · {st} started" : "")</div>}</div>
            @if (!Model.Keeper)
            {
                <div class="team-stat"><div class="team-stat-label">Goals</div><div class="team-stat-value">@(now.Goals?.ToString() ?? "–")</div></div>
                <div class="team-stat"><div class="team-stat-label">Assists</div><div class="team-stat-value">@(now.Assists?.ToString() ?? "–")</div></div>
            }
        </div>
        @if (now.Minutes < 900){<div class="page-note">Only @Js.Num(now.Minutes.Value) minutes so far: this season moves his Ability only a little until he plays more.</div>}
    }
    else
    {
        <div class="pl-callout">No league minutes in @Model.SeasonName yet@(Model.Listed is not null ? $" · listed {Model.Listed}" : "").
            @if (Model.Rank is { } rk){<text>His Ability of @rk comes from earlier seasons and his age curve, not from current form.</text>}</div>
    }
</div>

@if (Model.Skills is { } sk)
{
    <div class="club-section pl-block" id="pl-skills">
        <div class="modal-section">Skills · as @sk.AGroup</div>
        <div class="mc-scroll"><table class="calib-table mc-rows pl-skills">
            <thead><tr><th>Skill</th><th>His score</th><th>Counts in his rank</th></tr></thead>
            <tbody>@foreach (var l in sk.Lines)
            {
                <tr><td title="@l.Tip">@l.Label</td>
                    <td>@if (l.Score is { } sc){<span class="mc-progress"><span class="mc-bar"><span class="mc-fill sw-@l.Bar"></span></span><b>@Js.ToFixed(sc, 0)</b></span>}else{<text>–</text>}</td>
                    <td>@(l.Weight > 0 ? $"{l.Weight}%" : "–")</td></tr>
            }</tbody></table></div>
        @if (sk.Locked)
        {
            <div class="pl-callout">Skill scores are for subscribers. The mix is the same for every @sk.GroupName. <partial name="_SubscriberLink" /></div>
        }
        else if (!sk.Scored)
        {
            <div class="page-note">No skill scores yet: they need enough recent minutes in a league with match-by-match player data.</div>
        }
        @if (sk.Group == "GK")
        {
            <div class="page-note">Each keeper skill is where he stands among the keepers we rate, 0 to 100, over the same matches as his rank, pulled down if his clubs play below the main leagues' level. Goals prevented is his team's xG conceded less the goals he let in: the data has no post-shot xG, so the defence in front of him counts too. His rank uses save %, pass accuracy and goals conceded per 90. <a href="/methodology#terms">How player ratings work</a>.</div>
        }
        else
        {
        <div class="page-note">His score in each skill is where he stands among the regulars of the positions that use it, 0 to 100, over the same matches as his rank, after allowing for how much easier or harder his league makes that skill, and pulled down if his clubs play below the main leagues' level. His Ability starts from the strength of the clubs he has been a regular for; his stats then move it up or down, each skill counting by its share in @sk.AGroup's mix: by up to about 15 points, and up to twice that at the strongest clubs. A skill that isn't part of @sk.AGroup's rank shows "–": it is scored only for the positions that use it, against players of those positions. A position rank in another position uses that position's mix. <a href="/methodology#terms">How player ratings work</a>.</div>
        }
    </div>
}
