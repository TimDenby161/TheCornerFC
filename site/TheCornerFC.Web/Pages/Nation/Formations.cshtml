@page "/nation/{name}/formations"
@model TheCornerFC.Web.Pages.NationTabs.FormationsModel
@{
    var name = Model.N.Name;
    ViewData["Title"] = $"{name} formations · The Corner FC";
    ViewData["Description"] = $"The formations {name} have used under their head coach, and each starting XI match by match.";
}
@if (!Model.Any)
{
    <div class="empty-state">No line-ups for @name yet (they come from API-Football's international matches).</div>
}
else
{
    @if (Model.Coach is { } c)
    {
        <div class="next-card coach-card">@Markup.PersonChip(c.Name, "coach-photo")
            <div><div class="next-label">Head coach</div><div class="coach-name">@c.Name</div>
                <div class="next-meta"><span>@c.When</span><span>@c.Record</span></div></div></div>
    }
    <div class="club-section"><div class="modal-section">Formations · @Model.Label</div>
        @if (Model.Used.Count > 0)
        {
            <div class="fm-grid">
                @for (var i = 0; i < Model.Used.Count; i++)
                {
                    var f = Model.Used[i];
                    var dots = ClubPage.FormationDots(f.Formation);
                    <div class="fm-card@(i == 0 ? " top" : "")">
                        <svg class="fm-pitch" viewBox="0 0 60 80" aria-hidden="true">
                            <rect x="1" y="1" width="58" height="78" rx="3" class="fm-bg" />
                            <g class="fm-lines"><line x1="1" y1="40" x2="59" y2="40" /><circle cx="30" cy="40" r="6" /><rect x="16" y="1" width="28" height="10" /><rect x="16" y="69" width="28" height="10" /></g>
                            @for (var k = 0; k < dots.Count; k++){<circle cx="@Js.ToFixed(dots[k].X, 1)" cy="@Js.ToFixed(dots[k].Y, 1)" r="3.2" class="@(k > 0 ? "fm-dot" : "fm-gk")" />}
                        </svg>
                        <div class="fm-main"><div class="fm-name">@f.Formation</div>
                            <div class="fm-count">@f.Matches match@(f.Matches == 1 ? "" : "es") · @(f.Share < 1 ? "<1" : Js.RoundInt(f.Share).ToString())%</div>
                            <div class="fm-bar"><span class="sw-@ClubPage.Pct(f.Share)"></span></div>
                            <div class="fm-sub">@f.Record · @f.Gf–@f.Ga</div>
                            <div class="fm-sub">last @(f.Last[..4] == Model.ThisYear ? ClubPage.ShortDate(f.Last) : ClubPage.LongDate(f.Last))</div></div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="page-note">No formations known for these matches.</div>
        }
        @if (Model.Missing > 0){<div class="page-note">@Model.Missing match@(Model.Missing == 1 ? "" : "es") with no known line-up not counted.</div>}
    </div>
    <div class="club-section"><div class="modal-section">Match by match</div>
        @foreach (var m in Model.Games)
        {
            <details class="nat-match"><summary class="team-row">
                <span class="team-row-date">@m.Date</span>
                <span class="team-row-opp">@if (m.Flag is not null){<img class="flag" src="https://flagcdn.com/w40/@(m.Flag).png" alt="" loading="lazy" />} <a class="nat-link" href="/nation/@Js.EncodeUriComponent(m.Opp)">@m.Opp</a>
                    <span class="club-sub u-inline" title="@m.VenueName">@m.Venue · @m.Tournament</span></span>
                <span class="rel-chip rel-@(m.Gf > m.Ga ? 4 : m.Gf == m.Ga ? 3 : 1)">@m.Gf–@m.Ga</span>
                <span class="nat-fm">@(m.Formation is { Length: > 0 } fm ? fm : "–")</span></summary>
                @if (m.Xi.Count > 0)
                {
                    <div class="nat-xi">@foreach (var a in m.Xi){<span><span class="nat-xi-role">@a.Role</span>@if (a.Link){<a class="player-link" href="/player/@a.Id">@a.Name</a>}else{@a.Name}@if (a.Goals > 0){<text> </text><span class="nat-xi-goals" title="@a.Goals goal@(a.Goals == 1 ? "" : "s")">@string.Concat(Enumerable.Repeat("⚽", Math.Min(a.Goals, 4)))</span>}</span>}</div>
                }
                else
                {
                    <div class="page-note">No starting XI for this match.</div>
                }
            </details>
        }
    </div>
    <div class="page-note">@Model.Note</div>
}
